# Copy this file to .env (same folder) and fill in your own keys.
# .env is git-ignored. Never paste keys into chat, code, or frontend files.

# QpiAI Opt API key: https://opt.qpiai.tech  (free registration)
QPIAI_OPT_API_KEY=

# QpiAI QCloud API key: https://qcloud.qpiai.tech  (free registration)
# (QCLOUD_API_KEY is also accepted for compatibility with poc/)
QPIAI_QCLOUD_API_KEY=

# ---- optional settings (defaults shown) ----
# platform = Opt cloud job with job ID (may use credits); local = free authenticated local solve
QUPLINK_OPT_MODE=platform
# Device for pass-nonce QRNG circuits. Only QpiAI-Indus-1 is physical quantum randomness.
QUPLINK_QRNG_DEVICE=QpiAI-Indus-1
QUPLINK_QRNG_QUBITS=8
QUPLINK_QRNG_SHOTS=1024
# QAOA experiment: platform = QCloud circuit jobs on the device below; local = in-process simulator
QUPLINK_QAOA_MODE=platform
QUPLINK_QAOA_DEVICE=QpiAI-QSV-Simulator
QUPLINK_QAOA_MAX_ITERATIONS=30
QUPLINK_QAOA_REPS=1
QUPLINK_QAOA_SHOTS=1024
# Per-pass byte budgets (pass 1..T)
QUPLINK_PASS_BUDGETS=3600,3600,2900,2200
QUPLINK_FLOOD_LIMIT=8
QUPLINK_SAT_ID=42
# Development only: allow OS-only nonces when no QCloud job is available (clearly labelled DEV)
QUPLINK_ALLOW_DEV_NONCE=false
