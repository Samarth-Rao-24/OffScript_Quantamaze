# Copy this file to .env (same folder) and fill in your own keys.
# .env is git-ignored. Never paste keys into chat, code, or frontend files.

# QpiAI Opt API key: https://opt.qpiai.tech  (free registration)
QPIAI_OPT_API_KEY=

# QpiAI QCloud API key: https://qcloud.qpiai.tech  (free registration)
# (QCLOUD_API_KEY is also accepted for compatibility with poc/)
QPIAI_QCLOUD_API_KEY=

# ---- optional settings (defaults shown) ----
# Organiser guidance: after getting the API keys, run the QpiAI local solvers and simulators
# (no workspaces, platform utilities or credits needed). These are the defaults.
# local = QpiAI Opt local solver, authenticated with QPIAI_OPT_API_KEY (default)
# platform-qubo / platform = Opt cloud jobs with job IDs (need platform resources on the account)
QUPLINK_OPT_MODE=local
# Device for pass-nonce QRNG circuits. QpiAI-QSV-Local = QpiAI Quantum SDK simulator (default, no credits).
# QCloud devices (QpiAI-QSV-Simulator, QpiAI-Indus-1) need an active QCloud subscription.
QUPLINK_QRNG_DEVICE=QpiAI-QSV-Local
QUPLINK_QRNG_QUBITS=8
QUPLINK_QRNG_SHOTS=1024
# QAOA experiment: local = QpiAI Quantum SDK simulator (default); platform = QCloud circuit jobs on the device below
QUPLINK_QAOA_MODE=local
QUPLINK_QAOA_DEVICE=QpiAI-QSV-Simulator
QUPLINK_QAOA_MAX_ITERATIONS=30
QUPLINK_QAOA_REPS=1
QUPLINK_QAOA_SHOTS=1024
# ---- Private keys at rest (recommended) ----
# Any long passphrase. When set, every ground private key is sealed with scrypt + AES-256-GCM
# and plaintext key files are removed at start-up. Keep it out of chat, code and Git.
QUPLINK_KEY_PASSPHRASE=

# ---- NASA data (optional; real pass windows + space weather) ----
# Free key from https://api.nasa.gov (instant, emailed). Without it DEMO_KEY is used (rate-limited).
NASA_API_KEY=
# Spacecraft whose real orbit sets the pass windows (25544 = ISS, a stand-in for our simulated satellite)
QUPLINK_NORAD_ID=25544
QUPLINK_GS_NAME=Bengaluru
QUPLINK_GS_LAT=12.9716
QUPLINK_GS_LON=77.5946
QUPLINK_GS_ALT_M=920
# Command-uplink allocation in bit/s (budget = contact seconds x this / 8) and minimum elevation in degrees
QUPLINK_UPLINK_BPS=80
QUPLINK_MIN_ELEVATION=10
# Per-pass byte budgets (pass 1..T) used until NASA budgets are applied
QUPLINK_PASS_BUDGETS=3600,3600,2900,2200
QUPLINK_FLOOD_LIMIT=8
QUPLINK_SAT_ID=42
# QpiAI local-simulator QRNG runs may supply pass nonces (labelled, no cloud job ID)
QUPLINK_ALLOW_LOCAL_QRNG=true
# Development only: allow OS-only nonces with no QpiAI run at all (clearly labelled DEV)
QUPLINK_ALLOW_DEV_NONCE=false
